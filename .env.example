# copy to .env — every value documented in baseera/core/config.py
BASEERA_ENV=dev
BASEERA_DATABASE_URL=sqlite:///./data/baseera.db
BASEERA_DATA_DIR=./data
BASEERA_MODEL_DIR=./data/models
BASEERA_JWT_SECRET=change-me-in-production
BASEERA_JWT_MINUTES=15
BASEERA_CORS_ORIGINS=["http://localhost:8000"]
BASEERA_DEMO_PASSWORD=demo
# domain parameters (calibrate from survey / mentor sessions)
BASEERA_HORIZON_DAYS=14
BASEERA_LEAD_DEFAULT=7
BASEERA_CREW_JOBS_PER_WEEK=30
BASEERA_ALERT_PROBABILITY=0.10
BASEERA_EMERGENCY_MULTIPLIER=2.0
BASEERA_CONSEQUENCE_SAR_PER_UNIT=400
BASEERA_INTERVENTION_EFFICACY=0.85
BASEERA_MATCH_RADIUS_M=25
# cloud demo: seed the tagged simulation on an empty database at startup
BASEERA_AUTO_DEMO=false
BASEERA_AUTO_DEMO_AS_OF=2026-10-25
# docker compose
POSTGRES_PASSWORD=baseera
